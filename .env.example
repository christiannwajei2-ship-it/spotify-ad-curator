# ===================================================
# Spotify Ad Curator — Environment Variables
# ===================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ------ Spotify API ------
# Get these at: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Optional: Redirect URI for OAuth (set in Spotify dashboard too)
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# ------ Meta / Facebook Marketing API ------
# Get these at: https://developers.facebook.com/
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_APP_SECRET=your_meta_app_secret_here
VITE_META_ACCESS_TOKEN=your_meta_user_access_token_here
VITE_META_AD_ACCOUNT_ID=act_your_ad_account_id_here
VITE_META_PAGE_ID=your_facebook_page_id_here
VITE_META_INSTAGRAM_ACTOR_ID=your_instagram_actor_id_here

# ------ TikTok Marketing API ------
# Get these at: https://ads.tiktok.com/marketing_api/
VITE_TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
VITE_TIKTOK_ADVERTISER_ID=your_tiktok_advertiser_id_here

# ------ App Settings ------
# Set to "true" to use demo data instead of live APIs (recommended for initial setup)
# Change to "false" for production use with real API keys
VITE_DEMO_MODE=true
VITE_APP_NAME=Spotify Ad Curator
VITE_APP_URL=http://localhost:5173

# ------ Server (optional Express backend) ------
PORT=3001
NODE_ENV=development
